#version 450
// Smoke (rvk/smoke.cpp StepSmoke): a fluid simulation ("stable fluids") in a box of N^3 cells round a smoke source,
// one stage per dispatch (P.a.x):
//   0 velocity moved along itself (semi-Lagrangian), with the forces: buoyancy (hot smoke rises), the wind, the
//     source's push upwards; the ground (the box's floor) lets nothing through it
//   1 its curl;   2 vorticity confinement (the small swirls the grid would smooth away put back)
//   3 its divergence;   4 a Jacobi step of the pressure (P.e.w: the first, from 0);   5 the pressure's gradient taken
//     away (incompressible)
//   6 density and temperature moved along the velocity (MacCormack: 6 forward into the curl image, 8 that moved back
//     again into the divergence image, 9 the forward one corrected by half the round trip's error - clamped to what
//     was there, so it cannot overshoot: much sharper than moving it once), the source's added, fading
//   7 the sunlight reaching each cell through the smoke; with the density, the rendering's image (look)
//   10 (once) the wisps' noise for the rendering: tiling, 3 octaves of value noise
//   11 the velocity for the rendering's wisps (half the cells a side, 8 bits)
// Characters (B) stir it: the smoke in one moves with it, a moving one leaves eddies behind it.
// Velocities in world units / s, the box P.a.w world units across; the box may move with its source (P.e.xyz: by how
// much since last frame, in box units) - the contents stay where they are in the world.
// The sand volume (Sand.corner.w = 1; rvk/smoke.cpp sand): a box round the camera in a sand or ash storm. No source,
// no heat: the storm's wind blows through it (and in over its walls, with the sand it carries), the ground under each
// column (Sand.ground) is solid and gives sand off where the wind lifts it, in streaks; sand settles; a dust devil
// (Sand.devil) whirls it up; characters' feet kick it up.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0) uniform sampler3D velIn;            // filtered reads (moving things along)
layout(set = 0, binding = 1) uniform sampler3D densIn;           // R density, G temperature
layout(set = 0, binding = 2, rgba16f) uniform writeonly image3D velOut;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image3D densOut;
layout(set = 0, binding = 4, rgba16f) uniform image3D curlImg;   // xyz curl, w its length
layout(set = 0, binding = 5, r32f) uniform readonly image3D pIn;
layout(set = 0, binding = 6, r32f) uniform writeonly image3D pOut;
layout(set = 0, binding = 7, r32f) uniform image3D divImg;
layout(set = 0, binding = 8, rgba16f) uniform readonly image3D velRead;   // exact reads (neighbours)
layout(set = 0, binding = 9, rgba16f) uniform writeonly image3D lookImg;   // stage 7: R density, G sunlight; B A the
                                                                           // last step's
layout(set = 0, binding = 10) uniform sampler3D forwardIn;       // stage 8: the forward step (the curl image); stage 7:
                                                                 // the density before this step; stage 9 (a drift
                                                                 // cloud): its source's density
layout(set = 0, binding = 12, r16f) uniform writeonly image3D noiseOut;   // stage 10
layout(set = 0, binding = 14, rgba8_snorm) uniform writeonly image3D flowOut;   // stage 11 (half the cells a side)
// The characters in the box (rvk/smoke.cpp SmokeBodies): upright capsules the smoke moves with and flows round.
layout(set = 0, binding = 11, std140) uniform Bodies {
    vec4 info;          // x: how many; y: how strongly they stir it (RVK_SmokeStir)
    vec4 pos[8];        // x z: its middle, y: its feet, w: its top (box units)
    vec4 vel[8];        // xyz: its velocity (world / s); w: its radius (box units)
} B;

layout(push_constant) uniform Params {
    vec4 a;     // x: stage; y: N; z: dt (s); w: the box's size (world)
    vec4 b;     // xyz: the source (box units, 0..1); w: its radius (box units)
    vec4 c;     // x: the density the source keeps (in it; no more piles up there); y: the temperature it keeps;
                // z: the source's push up (world / s); w: how fast the density fades (1 / s) - x y z puffing
    vec4 d;     // x: buoyancy; y: vorticity confinement; zw: the wind (world / s, x z)
    vec4 e;     // xyz: the box's move since last frame (box units); w: stage 4: 1 = the first Jacobi step (pressure
                // from 0; else from the image's); stage 0: the step's number (the source's jitter)
    vec4 f;     // xyz: towards the sun (unit); w: the smoke's extinction (per world unit at density 1)
    vec4 g;     // x: the volume's slot in the bounds; y: stage 11: 1 / the flow image's range (world / s); z: the band
                // along a box's walls and top its smoke leaves over (box units)
    vec4 h;     // a drift cloud (w > 0): its source's box, uvw * w + xyz (stage 9 takes what that box lets go of)
} P;

// Each volume's cells with smoke in them (now or a step before), for the drawing: [2 slot] the lowest, [2 slot + 1]
// the highest (made empty before stage 7, which widens them).
layout(set = 0, binding = 13, std430) buffer Bounds { uvec4 bounds[]; };
// The sand volume's (rvk/smoke.cpp SandHeader; a smoke volume's: all 0).
layout(set = 0, binding = 15, std430) readonly buffer SandBlock {
    vec4 corner;        // xyz: the box's lowest corner (world); w: 1 = the sand volume
    vec4 wind;          // xy: the wind (world / s, x z); z: how fast sand settles (world / s); w: the wind's clock (s)
    vec4 air;           // x: the density blowing in at the ground; y: its scale height (world); z: the density the
                        // ground gives off (where it is sand); w: the streaks' size (world)
    vec4 devil;         // xyz: a dust devil's foot (box units); w: its radius (box units; 0: none)
    vec4 devil2;        // x: its spin (world / s); y: its lift (world / s); z: the density at its foot; w: characters'
                        // feet: the density kicked up per world / s they move
    vec4 devil3;        // xy: how it travels (world / s, x z); z: how far the wind has carried the sand (world; the
                        // streaks ride on it)
    vec2 ground[];      // a column's (z n + x): the ground's height (box units), how much sand it gives (0..1)
} SD;
shared uint sLow[3], sHigh[3];

// How much of a cell is inside a character (0..1) and how near it is (1 at its surface, 0 a body width away).
float InBody(vec3 uvw, int i, out float near_)
{
    vec4 b = B.pos[i];
    float r = B.vel[i].w, soft = 1.5 / P.a.y;
    vec3 axis = vec3(b.x, clamp(uvw.y, b.y + r, max(b.w - r, b.y + r)), b.z);
    float dist = length(uvw - axis);
    near_ = 1.0 - smoothstep(r, 2.2 * r + soft, dist);
    return 1.0 - smoothstep(r - soft, r + soft, dist);
}

// Value noise on a lattice repeating every `period` cells (so the image tiles).
float TileHash(ivec3 c, int period)
{
    uvec3 u = uvec3((c % period + period) % period);
    uint x = u.x * 73856093u ^ u.y * 19349663u ^ u.z * 83492791u ^ uint(period) * 2654435761u;
    x ^= x >> 16u; x *= 0x7FEB352Du; x ^= x >> 15u; x *= 0x846CA68Bu; x ^= x >> 16u;
    return float(x >> 8u) / 16777216.0;
}
float TileNoise(vec3 p, int period)
{
    ivec3 i = ivec3(floor(p));
    vec3 f = p - vec3(i);
    f = f * f * (3.0 - 2.0 * f);
    float c[8];
    for (int k = 0; k < 8; ++k)
        c[k] = TileHash(i + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1), period);
    return mix(mix(mix(c[0], c[1], f.x), mix(c[2], c[3], f.x), f.y), mix(mix(c[4], c[5], f.x), mix(c[6], c[7], f.x), f.y), f.z);
}

ivec3 Clamp(ivec3 c) { return clamp(c, ivec3(0), ivec3(int(P.a.y) - 1)); }

// -1..1 per cell and step (the source's unsteadiness: a perfectly steady source rises as a straight column).
float Jitter(ivec3 c, uint salt)
{
    uint x = uint(c.x) * 73856093u ^ uint(c.y) * 19349663u ^ uint(c.z) * 83492791u ^ salt * 2654435761u;
    x ^= x >> 16u; x *= 0x7FEB352Du; x ^= x >> 15u; x *= 0x846CA68Bu; x ^= x >> 16u;
    return float(x >> 8u) * (2.0 / 16777216.0) - 1.0;
}
vec3 Vel(ivec3 c) { return imageLoad(velRead, Clamp(c)).xyz; }

// The sand volume.
bool IsSand() { return SD.corner.w > 0.5; }
bool Outside(vec3 uvw) { return any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0))); }
// How far above the ground a point is (world; negative: in it), and how much sand the ground there gives.
float AboveGround(vec3 uvw, out float feed)
{
    int n = int(P.a.y);
    ivec2 c = clamp(ivec2(floor(uvw.xz * float(n))), ivec2(0), ivec2(n - 1));
    vec2 g = SD.ground[c.y * n + c.x];
    feed = g.y;
    return (uvw.y - g.x) * P.a.w;
}
// Streaks of blowing sand (0..1): long along the wind, narrow across, carried by it.
float Streaks(vec3 uvw)
{
    vec2 w = SD.corner.xz + uvw.xz * P.a.w;
    float speed = length(SD.wind.xy);
    vec2 along = speed > 1e-3 ? SD.wind.xy / speed : vec2(1.0, 0.0), across = vec2(-along.y, along.x);
    float t = SD.wind.w;
    vec2 q = vec2(dot(w, along) - SD.devil3.z, dot(w, across)) / SD.air.w;
    float n = 0.65 * TileNoise(vec3(q.x * 0.25, q.y, t * 0.2), 4096) + 0.35 * TileNoise(vec3(q.x * 0.5, q.y * 2.0, t * 0.35) + 17.0, 4096);
    return smoothstep(0.3, 0.7, n);
}
// The storm's wind at a point: a little slower near the ground (the sand hopping along it races still), none in it.
vec3 SandWind(vec3 uvw)
{
    float feed, above = AboveGround(uvw, feed);
    if (above < 0.0) return vec3(0.0);
    float k = clamp(0.65 + 0.35 * sqrt(above / 4.0), 0.65, 1.0);
    return vec3(SD.wind.x * k, 0.0, SD.wind.y * k);
}
// The sand blowing in over the walls, in streaks: most of it a thick layer hopping along the ground (the bottom
// world unit), over it a thinner dust thinning with height.
float SandInflow(vec3 uvw)
{
    float feed, above = AboveGround(uvw, feed);
    if (above < 0.0) return 0.0;
    float streak = Streaks(uvw);
    return SD.air.x * (1.8 * streak * exp(-above / 0.6) + 0.4 * (0.35 + 0.65 * streak) * exp(-above / max(SD.air.y, 0.1)));
}
// The density (and temperature) at a point: the image's, or beyond the walls what the storm brings.
vec2 DensAt(vec3 at)
{
    return IsSand() && Outside(at) ? vec2(SandInflow(at), 0.0) : texture(densIn, at).rg;
}
// The velocity the density moves with: sand settles through the air.
vec3 Carry(vec3 v) { return IsSand() ? v - vec3(0.0, SD.wind.z, 0.0) : v; }

void main()
{
    int n = int(P.a.y);
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(id, ivec3(n))))
        return;
    int stage = int(P.a.x);
    float dt = P.a.z, size = P.a.w, h = size / float(n);   // h: a cell (world)
    vec3 uvw = (vec3(id) + 0.5) / float(n);

    if (stage == 0 && IsSand()) {
        vec3 v = texelFetch(velIn, id, 0).xyz;
        vec3 back = uvw + P.e.xyz - v * (dt / size);
        v = Outside(back) ? SandWind(back) : texture(velIn, back).xyz;   // (in over the walls: the storm's wind)
        float feed, above = AboveGround(uvw, feed);
        vec3 wind = SandWind(uvw);
        v.xz += (wind.xz - v.xz) * (1.0 - exp(-1.5 * dt));
        // Gusty: eddies a few cells wide shoving it about, changing every few steps, as hard as the wind blows.
        float speed = length(SD.wind.xy);
        uint step_ = uint(P.e.w) / 8u;
        ivec3 eddy = id / 3;
        v += speed * 1.5 * dt * vec3(Jitter(eddy, step_), 0.6 * Jitter(eddy, step_ + 31u), Jitter(eddy, step_ + 7919u));
        // A dust devil: whirling round its axis (fastest at its radius), drawn in and lifted at its foot.
        if (SD.devil.w > 0.0) {
            vec2 r = (uvw.xz - SD.devil.xz) * size;
            float d = length(r), R = SD.devil.w * size, up = (uvw.y - SD.devil.y) * size;
            float tall = step(-1.0, up) * (1.0 - smoothstep(6.0, 14.0, up));
            float hold = (d < R ? 1.0 : R / max(d, 1e-3)) * (1.0 - smoothstep(3.0 * R, 5.0 * R, d)) * tall;
            float swirl = d < R ? d / R : R / max(d, 1e-3);                  // (a Rankine vortex: fastest at R)
            vec2 t = d > 1e-3 ? vec2(-r.y, r.x) / d : vec2(0.0);
            vec2 inward = d > 1e-3 ? -r / d : vec2(0.0);
            vec2 flat_ = t * SD.devil2.x * swirl + inward * abs(SD.devil2.x) * 0.3 * swirl * (1.0 - smoothstep(0.0, 2.0, up));
            float lift = SD.devil2.y * (1.0 - smoothstep(0.6 * R, 1.6 * R, d));
            v = mix(v, vec3(SD.devil3.x + flat_.x, lift, SD.devil3.y + flat_.y), hold * (1.0 - exp(-6.0 * dt)));
        }
        for (int i = 0; i < int(B.info.x); ++i) {
            float near_, inside = InBody(uvw, i, near_);
            vec3 bv = B.vel[i].xyz;
            v = mix(v, bv, inside * min(B.info.y, 1.0));
            float wake = near_ * (1.0 - inside) * length(bv) * 0.7 * B.info.y;
            uint salt = uint(P.e.w) / 4u + uint(i) * 131u;
            v += wake * vec3(Jitter(id / 2, salt), 0.5 * Jitter(id / 2, salt + 17u), Jitter(id / 2, salt + 7919u));
        }
        if (above < 0.0 || id.y == 0) v = vec3(0.0);                     // (the ground: solid)
        v *= exp(-0.05 * dt);
        imageStore(velOut, id, vec4(v, 0.0));
    } else if (stage == 0) {
        vec3 v = texelFetch(velIn, id, 0).xyz;
        vec3 back = uvw + P.e.xyz - v * (dt / size);
        v = texture(velIn, back).xyz;
        float temperature = texelFetch(densIn, id, 0).g;
        v.y += P.d.x * temperature * dt;                                 // buoyancy
        v.xz += (P.d.zw - v.xz) * (1.0 - exp(-0.4 * dt));                // dragged along by the wind
        vec3 d = (uvw - P.b.xyz) / max(P.b.w, 1e-4);
        float inSource = exp(-dot(d, d));
        v.y = mix(v.y, max(v.y, P.c.z), inSource);                       // the source pushes up
        // ... unsteadily: across it, in eddies a few cells wide changing every few steps (P.e.w: the step's number in
        // this stage) - finer jitter would only average away.
        uint step_ = uint(P.e.w) / 6u;
        ivec3 eddy = id / 3;
        v.xz += inSource * P.c.z * 0.8 * vec2(Jitter(eddy, step_), Jitter(eddy, step_ + 7919u));
        // Characters: inside one the smoke moves as it does (pushed ahead, pulled along behind - the pressure solve
        // sends the rest round it); round a moving one, eddies in its wake as fast as it goes.
        for (int i = 0; i < int(B.info.x); ++i) {
            float near_, inside = InBody(uvw, i, near_);
            vec3 bv = B.vel[i].xyz;
            v = mix(v, bv, inside * min(B.info.y, 1.0));
            float wake = near_ * (1.0 - inside) * length(bv) * 0.7 * B.info.y;
            uint salt = uint(P.e.w) / 4u + uint(i) * 131u;
            v += wake * vec3(Jitter(id / 2, salt), 0.5 * Jitter(id / 2, salt + 17u), Jitter(id / 2, salt + 7919u));
        }
        if (id.y == 0) v.y = max(v.y, 0.0);                              // the ground
        v *= exp(-0.05 * dt);
        imageStore(velOut, id, vec4(v, 0.0));
    } else if (stage == 1) {
        vec3 dx = (Vel(id + ivec3(1, 0, 0)) - Vel(id - ivec3(1, 0, 0))) / (2.0 * h);
        vec3 dy = (Vel(id + ivec3(0, 1, 0)) - Vel(id - ivec3(0, 1, 0))) / (2.0 * h);
        vec3 dz = (Vel(id + ivec3(0, 0, 1)) - Vel(id - ivec3(0, 0, 1))) / (2.0 * h);
        vec3 curl = vec3(dy.z - dz.y, dz.x - dx.z, dx.y - dy.x);
        imageStore(curlImg, id, vec4(curl, length(curl)));
    } else if (stage == 2) {
        float l = imageLoad(curlImg, Clamp(id - ivec3(1, 0, 0))).w, r = imageLoad(curlImg, Clamp(id + ivec3(1, 0, 0))).w;
        float bt = imageLoad(curlImg, Clamp(id - ivec3(0, 1, 0))).w, tp = imageLoad(curlImg, Clamp(id + ivec3(0, 1, 0))).w;
        float bk = imageLoad(curlImg, Clamp(id - ivec3(0, 0, 1))).w, fr = imageLoad(curlImg, Clamp(id + ivec3(0, 0, 1))).w;
        vec3 grad = vec3(r - l, tp - bt, fr - bk) / (2.0 * h);
        vec3 curl = imageLoad(curlImg, id).xyz;
        vec3 v = Vel(id);
        float gl = length(grad);
        if (gl > 1e-5)
            v += P.d.y * h * cross(grad / gl, curl) * dt;
        imageStore(velOut, id, vec4(v, 0.0));
    } else if (stage == 3) {
        // The box's walls are open (smoke leaves through them: the velocity beyond is the edge's); the floor is ground.
        float div = (Vel(id + ivec3(1, 0, 0)).x - Vel(id - ivec3(1, 0, 0)).x + Vel(id + ivec3(0, 1, 0)).y -
                     (id.y == 0 ? -Vel(id).y : Vel(id - ivec3(0, 1, 0)).y) + Vel(id + ivec3(0, 0, 1)).z -
                     Vel(id - ivec3(0, 0, 1)).z) / (2.0 * h);
        imageStore(divImg, id, vec4(div));
    } else if (stage == 4) {
        // Neighbours beyond the walls and the top: 0 (open); below the floor: this cell's (no flow through it).
        bool first = P.e.w > 0.5;
        float self = first ? 0.0 : imageLoad(pIn, id).x;
        float sum = 0.0;
        const ivec3 offs[6] = ivec3[](ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0), ivec3(0, -1, 0), ivec3(0, 0, 1),
                                      ivec3(0, 0, -1));
        for (int i = 0; i < 6; ++i) {
            ivec3 c = id + offs[i];
            if (c.y < 0) { sum += self; continue; }
            if (any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(n)))) continue;
            sum += first ? 0.0 : imageLoad(pIn, c).x;
        }
        float p = (sum - imageLoad(divImg, id).x * h * h) / 6.0;
        imageStore(pOut, id, vec4(p));
    } else if (stage == 5) {
        float self = imageLoad(pIn, id).x;
        float px1 = id.x + 1 < n ? imageLoad(pIn, id + ivec3(1, 0, 0)).x : 0.0;
        float px0 = id.x > 0 ? imageLoad(pIn, id - ivec3(1, 0, 0)).x : 0.0;
        float py1 = id.y + 1 < n ? imageLoad(pIn, id + ivec3(0, 1, 0)).x : 0.0;
        float py0 = id.y > 0 ? imageLoad(pIn, id - ivec3(0, 1, 0)).x : self;
        float pz1 = id.z + 1 < n ? imageLoad(pIn, id + ivec3(0, 0, 1)).x : 0.0;
        float pz0 = id.z > 0 ? imageLoad(pIn, id - ivec3(0, 0, 1)).x : 0.0;
        vec3 v = Vel(id) - vec3(px1 - px0, py1 - py0, pz1 - pz0) / (2.0 * h);
        if (id.y == 0) v.y = max(v.y, 0.0);
        float feed;
        if (IsSand() && AboveGround(uvw, feed) < 0.0) v = vec3(0.0);
        imageStore(velOut, id, vec4(v, 0.0));
    } else if (stage == 6) {
        vec3 v = Carry(texelFetch(velIn, id, 0).xyz);
        imageStore(curlImg, id, vec4(DensAt(uvw + P.e.xyz - v * (dt / size)), 0.0, 0.0));
    } else if (stage == 8) {
        vec3 v = Carry(texelFetch(velIn, id, 0).xyz);
        // (The scratch image may be bigger than this box: only its first n cells a side are this step's.)
        vec3 at = uvw - P.e.xyz + v * (dt / size);
        float back = Outside(at) ? (IsSand() ? SandInflow(at) : 0.0)
                   : texture(forwardIn, at * float(n) / vec3(textureSize(forwardIn, 0))).r;
        imageStore(divImg, id, vec4(back));
    } else if (stage == 9) {
        vec3 v = Carry(texelFetch(velIn, id, 0).xyz);
        vec3 at = (uvw + P.e.xyz - v * (dt / size)) * float(n) - 0.5;   // where it came from (cells)
        ivec3 c0 = ivec3(floor(at));
        float lo = 1e9, hi = -1e9;
        for (int k = 0; k < 8; ++k) {
            ivec3 c = c0 + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
            float x = any(lessThan(c, ivec3(0))) || any(greaterThanEqual(c, ivec3(n)))
                    ? (IsSand() ? SandInflow((vec3(c) + 0.5) / float(n)) : 0.0) : texelFetch(densIn, c, 0).r;
            lo = min(lo, x);
            hi = max(hi, x);
        }
        vec2 dens = imageLoad(curlImg, id).rg;
        dens.r = clamp(dens.r + 0.5 * (texelFetch(densIn, id, 0).r - imageLoad(divImg, id).r), lo, hi);
        if (IsSand()) {
            // Fading slowly (it settles out, P.c.w); given off the ground where the wind lifts it - in streaks, the
            // more where the ground is sand - at a dust devil's foot, and where characters' feet kick it up.
            float feed, above = AboveGround(uvw, feed);
            dens.r *= exp(-P.c.w * dt);
            float level = 0.0;
            if (above >= 0.0 && above < 0.8)
                level = SD.air.z * feed * (0.1 + 0.9 * Streaks(uvw)) * (1.0 - above / 0.8);
            if (SD.devil.w > 0.0) {
                float d = length((uvw.xz - SD.devil.xz) * size), R = SD.devil.w * size;
                float up = (uvw.y - SD.devil.y) * size;
                level = max(level, SD.devil2.z * (1.0 - smoothstep(0.3 * R, 1.6 * R, d)) * (1.0 - smoothstep(0.0, 1.5, up)) *
                                   step(0.0, above));
            }
            for (int i = 0; i < int(B.info.x); ++i) {
                vec3 foot = vec3(B.pos[i].x, B.pos[i].y, B.pos[i].z);
                float speed = length(B.vel[i].xz), d = length((uvw - foot) * size);
                level = max(level, SD.devil2.w * speed * (1.0 - smoothstep(0.15, 0.6, d)) * step(0.0, above));
            }
            dens.r = max(dens.r, min(dens.r + level * 3.0 * dt, level));
            dens.g = 0.0;
            if (above < 0.0) dens = vec2(0.0);
            imageStore(densOut, id, vec4(max(dens, vec2(0.0)), 0.0, 0.0));
            return;
        }
        vec3 d = (uvw - P.b.xyz) / max(P.b.w, 1e-4);
        float inSource = exp(-dot(d, d));
        // (Built up there over a moment - no blob popping in - up to the level, no more.)
        float level = P.c.x * inSource;
        dens.r = dens.r * exp(-P.c.w * dt);
        dens.r = max(dens.r, min(dens.r + level * 4.0 * dt, level));
        dens.g = max(dens.g, P.c.y * inSource) * exp(-0.6 * dt);       // (the source as hot as that, however small)
        for (int i = 0; i < int(B.info.x); ++i) {                       // (none left inside a character)
            float near_, inside = InBody(uvw, i, near_);
            dens *= 1.0 - inside * min(12.0 * dt, 1.0) * min(B.info.y, 1.0);
        }
        // A drift cloud: within its source's box, the smoke that box lets go of (along its walls and top - as much
        // as the drawing thins it out there) is this one's; inside it, none (that box's own).
        if (P.h.w > 0.0) {
            vec3 pu = uvw * P.h.w + P.h.xyz;
            if (all(greaterThan(pu, vec3(0.0))) && all(lessThan(pu, vec3(1.0)))) {
                vec2 side = min(pu.xz, 1.0 - pu.xz);
                float kept = smoothstep(0.0, P.g.z, min(min(side.x, side.y), 1.0 - pu.y));
                dens = max(dens, texture(forwardIn, pu).rg) * (1.0 - kept);
            }
        }
        // Fading out towards the walls and the top (what reaches them leaves the box).
        vec3 edge = min(uvw, 1.0 - uvw);
        dens *= smoothstep(0.0, 0.06, min(min(edge.x, edge.z), 1.0 - uvw.y));
        imageStore(densOut, id, vec4(max(dens, vec2(0.0)), 0.0, 0.0));
    } else if (stage == 10) {
        float w = 0.55 * TileNoise(uvw * 8.0, 8) + 0.3 * TileNoise(uvw * 16.0 + 5.0, 16) + 0.15 * TileNoise(uvw * 32.0 + 3.0, 32);
        imageStore(noiseOut, id, vec4(w));
    } else if (stage == 11) {
        // (Each cell the average of the 2^3 under it: filtered at their shared corner.)
        int half_ = n / 2;
        if (any(greaterThanEqual(id, ivec3(half_))))
            return;
        vec3 v = texture(velIn, (vec3(id) + 0.5) / float(half_)).xyz;
        imageStore(flowOut, id, vec4(clamp(v * P.g.y, -1.0, 1.0), 0.0));
    } else if (stage == 7) {
        if (gl_LocalInvocationIndex == 0u) {
            sLow[0] = sLow[1] = sLow[2] = 0xFFFFFFFFu;
            sHigh[0] = sHigh[1] = sHigh[2] = 0u;
        }
        barrier();
        // Towards the sun, to the box's edge: the smoke the light goes through.
        vec3 s = P.f.xyz;
        float stepLen = 1.5 / float(n), optical = 0.0;
        vec3 p = uvw;
        for (int i = 0; i < 24; ++i) {
            p += s * stepLen;
            if (any(lessThan(p, vec3(0.0))) || any(greaterThan(p, vec3(1.0))))
                break;
            optical += texture(densIn, p).r;
        }
        // With the density before this step, which the drawing blends from (the simulation steps less often than
        // frames) - read where this cell was then, as the box may have moved with its source since (P.e).
        float now = texelFetch(densIn, id, 0).r;
        float sunlit = exp(-optical * P.f.w * stepLen * size);
        vec2 last = vec2(texture(forwardIn, uvw + P.e.xyz).r, sunlit);
        imageStore(lookImg, id, vec4(now, sunlit, last));
        // The bounds (the drawing skips smoke thinner than this): the group's, then the volume's.
        if (max(now, last.x) >= 1e-4) {
            uvec3 u = uvec3(id);
            atomicMin(sLow[0], u.x); atomicMin(sLow[1], u.y); atomicMin(sLow[2], u.z);
            atomicMax(sHigh[0], u.x); atomicMax(sHigh[1], u.y); atomicMax(sHigh[2], u.z);
        }
        barrier();
        if (gl_LocalInvocationIndex == 0u && sLow[0] <= sHigh[0]) {
            uint slot = uint(P.g.x) * 2u;
            atomicMin(bounds[slot].x, sLow[0]); atomicMin(bounds[slot].y, sLow[1]); atomicMin(bounds[slot].z, sLow[2]);
            atomicMax(bounds[slot + 1u].x, sHigh[0]); atomicMax(bounds[slot + 1u].y, sHigh[1]);
            atomicMax(bounds[slot + 1u].z, sHigh[2]);
        }
    }
}
